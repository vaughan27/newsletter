# Copy to .env and edit.

# Postgres (create the database first: createdb newsletters)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/newsletters

# REQUIRED. At least 32 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Bearer token lifetime in minutes (480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# First admin, created on startup ONLY when the users table is empty.
# Change the password after first login (Dashboard > Account).
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_FULL_NAME=Administrator

# Dashboard "today" and daily traffic are bucketed in this timezone
APP_TIMEZONE=Asia/Kuwait

# Set true when served over HTTPS (marks the visitor cookie Secure)
COOKIE_SECURE=false

# Only needed if the frontend is served from a different origin than the API
# (comma separated). Not needed with the Vite proxy or when FastAPI serves the build.
CORS_ORIGINS=

# Upload limits
MAX_PDF_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10

# Cover images: aspect ratio and output width in px (height is derived).
# One place to change it for every newsletter you regenerate.
COVER_ASPECT_WIDTH=16
COVER_ASPECT_HEIGHT=9
COVER_WIDTH_PX=1280
